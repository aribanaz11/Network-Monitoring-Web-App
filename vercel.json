{
  "version": 2,
  "builds": [
    {
      "src": "backend/netwatch_core/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/netwatch_core/wsgi.py"
    },
    {
      "src": "/src/(.*)",
      "dest": "frontend/src/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
