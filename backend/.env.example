# NetWatch Backend Environment Configuration Template
DJANGO_SECRET_KEY=your-django-production-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.up.railway.app

# Fernet 32-byte Encryption Key (Keep secret - required to decrypt credentials)
FERNET_KEY=your-32-byte-base64-fernet-key-here

# Database Configuration
USE_SQLITE=True
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/<db_name>
DB_NAME=netwatch_db
DB_USER=netwatch_user
DB_PASSWORD=your-database-password-here
DB_HOST=localhost
DB_PORT=5432

# Seed Passwords (Optional)
DEFAULT_ADMIN_PASSWORD=your-custom-admin-password
DEFAULT_OPERATOR_PASSWORD=your-custom-operator-password
DEFAULT_VIEWER_PASSWORD=your-custom-viewer-password

# Cache & Message Broker
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Optional Telemetry & Streaming
MONGODB_ENABLED=False
MONGODB_URI=mongodb://localhost:27017/
KAFKA_ENABLED=False
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

SIMULATOR_MODE=True
