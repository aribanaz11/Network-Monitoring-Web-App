# ==============================================================================
# NetWatch Network Device Monitoring System — Environment Configuration Template
# Copy this file to .env and configure values appropriate for your environment.
# DO NOT COMMIT PRODUCTION SECRETS OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# --- Core Django Settings ---
# Generate a secure 50+ character secret key in production:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-django-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=*,.onrender.com,localhost,127.0.0.1

# --- Security & Symmetric Encryption ---
# Fernet 32-byte url-safe base64 key for device credential encryption at rest:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FERNET_KEY=your-fernet-encryption-key-here

# --- Database Configuration ---
# Set to 'False' in production when PostgreSQL is provided via DATABASE_URL
USE_SQLITE=False
# Render automatically provides DATABASE_URL when a PostgreSQL database is attached:
# e.g., postgresql://netwatch_user:password@dpg-xxx-a.render.com/netwatch_db
DATABASE_URL=

# --- Monitoring Simulation Engine ---
# Set to 'True' for simulated packet loss/jitter on synthetic lab nodes (10.0.0.x / 192.168.x.x)
# Set to 'False' when probing physical network hardware
SIMULATOR_MODE=True

# --- Distributed Asynchronous Workers & Caching ---
# Set to 'True' for monolithic web dyno execution (executes Celery tasks synchronously)
# Set to 'False' when running dedicated Celery worker containers
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Optional Cloud Telemetry & Event Streaming ---
MONGODB_ENABLED=False
MONGODB_URI=
KAFKA_ENABLED=False
KAFKA_BOOTSTRAP_SERVERS=
