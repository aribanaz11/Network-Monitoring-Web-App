# ==============================================================================
# NetWatch Network Device Monitoring System — Environment Configuration Template
# Copy this file to .env and configure values appropriate for your environment.
# DO NOT COMMIT PRODUCTION SECRETS OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# --- Core Django Settings ---
# Generate a secure 50+ character secret key in production:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-django-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.up.railway.app

# --- Security & Symmetric Encryption ---
# Fernet 32-byte url-safe base64 key for device credential encryption at rest:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# CRITICAL: The Fernet key must be kept secret. Losing the key will make encrypted credentials unrecoverable.
FERNET_KEY=your-32-byte-base64-fernet-key-here

# --- Database Configuration ---
# Set USE_SQLITE=True for local file-based database or False when using PostgreSQL
USE_SQLITE=True
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>
DB_NAME=netwatch_db
DB_USER=netwatch_user
DB_PASSWORD=your-database-password-here
DB_HOST=localhost
DB_PORT=5432

# --- Initial Seed User Passwords (Optional) ---
# Configure custom seed passwords before initial deployment migration
DEFAULT_ADMIN_PASSWORD=your-custom-admin-password
DEFAULT_OPERATOR_PASSWORD=your-custom-operator-password
DEFAULT_VIEWER_PASSWORD=your-custom-viewer-password

# --- Monitoring Simulation Engine ---
# Set to 'True' for simulated packet loss/jitter on synthetic lab nodes (10.0.0.x / 192.168.x.x)
# Set to 'False' when probing physical network hardware
SIMULATOR_MODE=True

# --- Distributed Asynchronous Workers & Caching ---
# Set to 'True' for synchronous execution or False for dedicated Celery worker containers
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Optional Cloud Telemetry & Event Streaming ---
MONGODB_ENABLED=False
MONGODB_URI=mongodb://localhost:27017/
KAFKA_ENABLED=False
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
